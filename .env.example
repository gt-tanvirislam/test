# ──────────────────────────────────────────────────────────────
# Tamvir Islam Platform — Environment Variables Reference
# Copy this file to .env.local (web) and .env (api) and fill in real values.
# Never commit actual secrets. See docs/deployment/runbook.md.
# ──────────────────────────────────────────────────────────────

# ── Supabase (shared by web + api) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Frontend (apps/web) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Tamvir Islam"

# ── Backend (apps/api) ──────────────────────────────────────────
DATABASE_URL=
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
REVALIDATION_SECRET=
# Shared secret protecting POST /api/v1/scheduler/run-due (the scheduled-publish
# sweep a cron calls). Leave empty to disable the endpoint — it fails closed.
SCHEDULER_SECRET=

# ── Reserved / not yet wired (open provider decisions — see
#    Phase 2.1 §31, Phase 2.8 §20) ──────────────────────────────
EMAIL_PROVIDER_API_KEY=
ERROR_TRACKING_DSN=
ANALYTICS_PROVIDER_ID=
